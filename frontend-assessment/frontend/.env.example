# Backend API URL used by Next.js route handlers that proxy to Express.
# Falls back to http://localhost:4000 when unset (see lib/constants.ts).
#
# Local development (backend on your machine):
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:4000
#
# Docker Compose (frontend container talking to backend service):
# NEXT_PUBLIC_BACKEND_API_URL=http://backend:4000
#
# Vercel (after deploying the backend project):
# NEXT_PUBLIC_BACKEND_API_URL=https://your-backend.vercel.app
